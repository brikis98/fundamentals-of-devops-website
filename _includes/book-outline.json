{
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "{{ site.name }}",
  "description": "{{ site.description }}",
  "image": "{{ site.url }}{% include image-url.html path=site.book_cover_path %}",
  "url": "{{ site.url }}",
  "inLanguage": "{{ site.language }}",
  "datePublished": "{{ site.date_published }}",
  "isbn": "{{ site.isbn }}",
  "bookEdition": "{{ site.edition }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.author_url }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.publisher }}"
  },
  "hasPart": [
    {% assign real_chapters = "" | split: "" %}
    {% for chapter in site.data.outline %}
      {% unless chapter.skip_chapter_heading %}
        {% assign chapter_as_array = chapter | reverse | reverse %}
        {% assign real_chapters = real_chapters | concat: chapter_as_array %}
      {% endunless %}
    {% endfor %}
    {% for chapter in real_chapters %}
      {% assign empty_array = "" | split: "" %}
      {% assign key_ideas = chapter.key_ideas | default: empty_array %}
      {% assign examples = chapter.examples | default: empty_array %}
      {
        "@type": "Chapter",
        "position": {{ forloop.index }},
        "name": "{{ chapter.title }}",
        "description": "Key ideas: {{ chapter.key_ideas | join: ', ' }}.{% if chapter.examples %} Examples: {{ chapter.examples | join: ', ' }}.{% endif %}",
        "learningResourceType": "Technical Tutorial",
        "url": "{{ site.url }}{% include chapter-url.html chapter_index=forloop.index chapter_title=chapter.title %}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "offers": [
    {% for store in site.data.stores %}
    {
      "@type": "Offer",
      "seller": {
        "@type": "Organization",
        "name": "{{ store.name }}"
      },
      "url": "{{ store.url }}"
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}