{
  "@context": "https://schema.org",
  "@type": "Book",
  "name": {{ site.name | jsonify }},
  "description": {{ site.description | jsonify }},
  "image": "{{ site.url }}{% include image-url.html path=site.book_cover_path %}",
  "url": {{ site.url | jsonify }},
  "inLanguage": {{ site.language | jsonify }},
  "datePublished": {{ site.date_published | jsonify }},
  "isbn": {{ site.isbn | jsonify }},
  "bookEdition": {{ site.edition | jsonify }},
  "author": {% include author.json %},
  "publisher": {% include book-publisher.json %},
  "hasPart": {% include chapters.json %},
  "offers": {% include offers.json %}
}