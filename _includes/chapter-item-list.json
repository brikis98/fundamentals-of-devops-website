{%- assign chapter_index = page.path | replace: 'chapters/chapter-', '' | replace: '/index.html', '' | minus: 1 -%}
{%- assign chapter = site.data.outline[chapter_index] -%}
{%- assign chapter_number = chapter_index | plus: 1 -%}
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ "Chapter " | append: chapter_number | append: " examples" | jsonify }},
  "itemListElement": [
    {% for example in chapter.examples %}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "name": {{ example | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}