---
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.name | xml_escape }}</title>
    <description>{% if site.description %}{{ site.description | xml_escape }}{% endif %}</description>
    <link>{{ site.url }}</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
    {% assign items = site.posts %}
    {% for item in items limit:10 %}
      <item>
        <title>{{ item.title | strip_html | xml_escape }}</title>
        {% if item.author.name %}
          <dc:creator>{{ item.author.name | xml_escape }}</dc:creator>
        {% endif %}
        {% if item.description %}
          <description>{{ item.description | strip_html | xml_escape }}</description>
        {% endif %}
        <pubDate>{{ item.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
        <link>{% include canonical-url.html url=item.url %}</link>
        <guid isPermaLink="true">{% include canonical-url.html url=item.url %}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>